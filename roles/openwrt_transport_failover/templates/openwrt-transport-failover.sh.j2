#!/bin/sh
# Managed by Ansible. Generic OpenWrt transport failover dataplane owner.
set -u

instance_name='{{ openwrt_xp2p_three_x_ui_intercept_failover_instance_name }}'
log_tag="$instance_name"
transport_interface='{{ openwrt_xp2p_three_x_ui_intercept_failover_interface }}'
route_table='{{ openwrt_xp2p_three_x_ui_intercept_failover_table }}'
rule_section='{{ openwrt_xp2p_three_x_ui_intercept_failover_rule_section }}'
route_section='{{ openwrt_xp2p_three_x_ui_intercept_failover_route_section }}'
wan_interface='{{ openwrt_xp2p_three_x_ui_intercept_failover_wan_interface }}'
routing_file='{{ openwrt_xp2p_three_x_ui_intercept_failover_routing_file }}'
state_file='{{ openwrt_xp2p_three_x_ui_intercept_failover_state_file }}'
backup_file='{{ openwrt_xp2p_three_x_ui_intercept_failover_backup_file }}'
route_control_helper='{{ openwrt_route_control_runtime_helper_path }}'
lock_dir="${state_file}.lock"
dead_after_failures='{{ openwrt_xp2p_three_x_ui_intercept_failover_dead_after_failures | int }}'
restore_after_successes='{{ openwrt_xp2p_three_x_ui_intercept_failover_restore_after_successes | int }}'
disable_intercept_when_dead='{{ openwrt_xp2p_three_x_ui_intercept_failover_disable_intercept_when_dead | bool | lower }}'
restore_intercept_when_alive='{{ openwrt_xp2p_three_x_ui_intercept_failover_restore_intercept_when_alive | bool | lower }}'
use_socks_smoke='{{ openwrt_xp2p_three_x_ui_intercept_failover_use_socks_smoke | bool | lower }}'
socks_port='{{ openwrt_xp2p_three_x_ui_intercept_failover_socks_port | int }}'
candidate_tags_json='{{ openwrt_transport_failover_candidates
  | selectattr("type", "equalto", "xp2p_xray")
  | map(attribute="outbound_tag")
  | list
  | to_json }}'

if ! mkdir "$lock_dir" 2>/dev/null; then
  exit 0
fi
trap 'rmdir "$lock_dir" 2>/dev/null || true' 0 1 2 3 15

log() {
  logger -t "$log_tag" "$*"
  printf '%s\n' "$*"
}

intercept_disabled() {
  disabled="$(uci -q get "network.${rule_section}.disabled" 2>/dev/null || true)"
  [ "$disabled" = "1" ] || [ "$disabled" = "true" ]
}

route_table_has_default() {
  ip route show table "$route_table" 2>/dev/null |
    grep -E '^default([[:space:]]|$)' >/dev/null
}

transport_status() {
  candidate_tag="$1"
  status=''
  state_json="$(xp2p client state --json 2>/dev/null || true)"
  if command -v jsonfilter >/dev/null 2>&1; then
    status="$(printf '%s\n' "$state_json" | jsonfilter -e "@.result.tunnels[@.tag='${candidate_tag}'].status" 2>/dev/null | head -n 1)"
  fi
  if [ -z "$status" ]; then
    state="$(xp2p client state 2>/dev/null || true)"
    status="$(printf '%s\n' "$state" | awk -v tag="$candidate_tag" '$1 == tag { print $3; exit }')"
  fi
  [ -n "$status" ] || status=missing
  printf '%s\n' "$status"
}

transport_enabled() {
  candidate_tag="$1"
  state="$(xp2p client list 2>/dev/null | awk -v tag="$candidate_tag" '$2 == tag { print $NF; exit }')"
  [ "$state" = enabled ]
}

socks_probe() {
  expected_ip="$1"
  probe_urls="$2"
  probe_destinations="$3"
  required_successes="$4"
  [ "$use_socks_smoke" = "true" ] || return 0
  probe_successes=0
  probe_index=1
  for probe_url in $(printf '%s' "$probe_urls" | tr '|' ' '); do
    destination_ipv4="$(printf '%s' "$probe_destinations" | cut -d '|' -f "$probe_index")"
    authority="${probe_url#*://}"
    authority="${authority%%/*}"
    probe_host="${authority%%:*}"
    probe_port="${authority##*:}"
    [ "$probe_port" = "$probe_host" ] && probe_port=443
    resolve_args=''
    [ -n "$destination_ipv4" ] && resolve_args="--resolve ${probe_host}:${probe_port}:${destination_ipv4}"
    # shellcheck disable=SC2086
    probe_output="$(curl --socks5-hostname "127.0.0.1:${socks_port}" $resolve_args -fsS --connect-timeout 3 --max-time 8 \
      "$probe_url" 2>/dev/null | tr -d '\r\n' || true)"
    [ "$probe_output" = "$expected_ip" ] && probe_successes=$((probe_successes + 1))
    probe_index=$((probe_index + 1))
  done
  [ "$probe_successes" -ge "$required_successes" ]
}

wan_probe() {
  probe_urls="$1"
  probe_destinations="$2"
  required_successes="$3"
  expected_country="$4"
  [ "$use_socks_smoke" = "true" ] || return 0
  probe_successes=0
  probe_index=1
  for probe_url in $(printf '%s' "$probe_urls" | tr '|' ' '); do
    destination_ipv4="$(printf '%s' "$probe_destinations" | cut -d '|' -f "$probe_index")"
    authority="${probe_url#*://}"
    authority="${authority%%/*}"
    probe_host="${authority%%:*}"
    probe_port="${authority##*:}"
    [ "$probe_port" = "$probe_host" ] && probe_port=443
    resolve_args=''
    [ -n "$destination_ipv4" ] && resolve_args="--resolve ${probe_host}:${probe_port}:${destination_ipv4}"
    # shellcheck disable=SC2086
    probe_output="$(curl --interface "$wan_interface" -fsS $resolve_args --connect-timeout 3 --max-time 8 \
      "$probe_url" 2>/dev/null || true)"
    if [ -n "$probe_output" ] && {
      [ -z "$expected_country" ] || printf '%s\n' "$probe_output" | grep -Eiq '"country"[[:space:]]*:[[:space:]]*"?'"$expected_country"'"?|country[=:][[:space:]]*'"$expected_country";
    }; then
      probe_successes=$((probe_successes + 1))
    fi
    probe_index=$((probe_index + 1))
  done
  [ "$probe_successes" -ge "$required_successes" ]
}

candidate_healthy() {
  candidate_type="$1"
  candidate_tag="$2"
  expected_ip="$3"
  independent_probe="$4"
  probe_urls="$5"
  probe_destinations="$6"
  required_successes="$7"
  expected_country="$8"
  peer_public_key="$9"
  if [ "$candidate_type" = wan_direct ]; then
    [ -n "$wan_interface" ] || return 1
    wan_probe "$probe_urls" "$probe_destinations" "$required_successes" "$expected_country"
    return $?
  fi
  if [ "$candidate_type" = xp2p_xray ]; then
    [ "$candidate_tag" != "" ] || return 1
    transport_enabled "$candidate_tag" || return 1
    active_tag="$(active_transport)"
    if [ "$candidate_tag" != "$active_tag" ] && [ "$independent_probe" != true ]; then
      candidate_status="$(transport_status "$candidate_tag")"
      [ "$candidate_status" = healthy ] || [ "$candidate_status" = alive ]
      return $?
    fi
    [ "$(transport_status "$candidate_tag")" = healthy ] ||
      [ "$(transport_status "$candidate_tag")" = alive ] || return 1
    socks_probe "$expected_ip" "$probe_urls" "$probe_destinations" "$required_successes"
    return $?
  fi
  if [ "$candidate_type" = wireguard ]; then
    candidate_interface="$candidate_tag"
    candidate_endpoint="$expected_ip"
    ip link show "$candidate_interface" >/dev/null 2>&1 || return 1
    ip route get "$candidate_endpoint" >/dev/null 2>&1 || return 1
    command -v wg >/dev/null 2>&1 || return 1
    [ -n "$peer_public_key" ] || return 1
    now="$(date +%s)"
    handshake="$(wg show "$candidate_interface" latest-handshakes "$peer_public_key" 2>/dev/null | awk 'NF {print $2; exit}' || true)"
    [ -n "$handshake" ] && [ "$handshake" -gt 0 ] && [ "$((now - handshake))" -le 180 ] && return 0
  fi
  return 1
}

active_transport() {
  routing_tag="$(routing_active_transport)"
  if [ -n "$routing_tag" ]; then
    printf '%s\n' "$routing_tag"
    return 0
  fi
  if [ -f "$state_file" ]; then
    sed -n 's/^active_transport=//p' "$state_file" | head -n 1
  fi
}

state_value() {
  key="$1"
  default_value="$2"
  value=''
  if [ -f "$state_file" ]; then
    value="$(sed -n "s/^${key}=//p" "$state_file" | head -n 1)"
  fi
  [ -n "$value" ] && printf '%s\n' "$value" || printf '%s\n' "$default_value"
}

write_state() {
  state_active="$1"
  state_failures="$2"
  state_successes="$3"
  state_tmp="${state_file}.tmp.$$"
  mkdir -p "$(dirname "$state_file")"
  routing_tag="$(routing_active_transport)"
  {
    # Xray active transport is owned by the terminal routing rule. Do not
    # persist a second candidate value that an external XP2P watcher can
    # invalidate between two failover cycles.
    if [ -z "$routing_tag" ]; then
      printf 'active_transport=%s\n' "$state_active"
    fi
    printf 'preferred_failures=%s\n' "$state_failures"
    printf 'preferred_successes=%s\n' "$state_successes"
  } > "$state_tmp"
  mv "$state_tmp" "$state_file"
}

routing_active_transport() {
  [ -f "$routing_file" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  jq -r --argjson candidates "$candidate_tags_json" '
    .rules[-1].outboundTag as $tag |
    if ($tag != null and ($candidates | index($tag)) != null) then $tag else "" end
  ' "$routing_file" 2>/dev/null || true
}

reconcile_state_with_routing() {
  actual_tag="$(routing_active_transport)"
  [ -n "$actual_tag" ] || return 0
  recorded_tag="$(active_transport)"
  if [ "$recorded_tag" != "$actual_tag" ]; then
    write_state "$actual_tag" 0 0
    log "reconciled failover state to routing outbound ${actual_tag}"
  fi
}

switch_routing_outbound() {
  desired_tag="$1"
  expected_ip="$2"
  probe_urls="$3"
  probe_destinations="$4"
  required_successes="$5"
  current_tag="$(routing_active_transport)"
  [ -n "$current_tag" ] || current_tag="$(active_transport)"
  [ "$current_tag" = "$desired_tag" ] && return 0
  [ -f "$routing_file" ] || return 1
  [ -f "$backup_file" ] || cp -p "$routing_file" "$backup_file"
  rollback_file="${routing_file}.failover-rollback.$$"
  cp -p "$routing_file" "$rollback_file"
  if ! "$route_control_helper" replace-xray-outbound "$routing_file" "$desired_tag" "$candidate_tags_json"; then
    rm -f "$rollback_file"
    return 1
  fi
  if ! xp2p client service restart >/dev/null 2>&1; then
    mv "$rollback_file" "$routing_file"
    reconcile_state_with_routing
    return 1
  fi
  sleep 30
  if ! socks_probe "$expected_ip" "$probe_urls" "$probe_destinations" "$required_successes"; then
    mv "$rollback_file" "$routing_file"
    xp2p client service restart >/dev/null 2>&1 || true
    sleep 30
    reconcile_state_with_routing
    return 1
  fi
  if [ "$(routing_active_transport)" != "$desired_tag" ]; then
    log "routing outbound drifted after probe; refusing to commit state for ${desired_tag}"
    mv "$rollback_file" "$routing_file"
    xp2p client service restart >/dev/null 2>&1 || true
    sleep 30
    reconcile_state_with_routing
    return 1
  fi
  rm -f "$rollback_file"
  write_state "$desired_tag" 0 0
  log "switched managed Xray outbound to ${desired_tag}"
}

disable_intercept_rule() {
  intercept_disabled && return 0
  "$route_control_helper" set-intercept disabled
  log "disabled LAN intercept rule ${rule_section}; WAN direct fallback is active"
}

enable_intercept_rule() {
  ! intercept_disabled && return 0
  "$route_control_helper" set-intercept enabled
  log "enabled LAN intercept rule ${rule_section}; table ${route_table} is active"
}

select_transport() {
{% for candidate in openwrt_transport_failover_candidates %}
  if candidate_healthy '{{ candidate.type }}' '{{ candidate.outbound_tag | default(candidate.dataplane.interface | default('')) }}' '{{ candidate.expected_public_ip | default(candidate.endpoint.host | default('')) }}' '{{ candidate.dataplane.independent_egress_probe | default(false) | lower }}' '{{ candidate.probes | default([]) | map(attribute="url") | join("|") }}' '{% for probe in candidate.probes | default([]) %}{{ probe.destination_ipv4 | default(['']) | first | default('') }}{% if not loop.last %}|{% endif %}{% endfor %}' '{{ candidate.probe_policy.required_successes | default(1) | int }}' '{{ candidate.probes | selectattr("expected_country", "defined") | map(attribute="expected_country") | first | default("") }}' '{{ candidate.endpoint.peer_public_key | default("") }}'; then
    printf '%s\n' '{{ candidate.id }}|{{ candidate.type }}|{{ candidate.outbound_tag | default(candidate.dataplane.interface | default('')) }}'
    return 0
  fi
{% endfor %}
  return 1
}

if ! route_table_has_default; then
  disable_intercept_rule
  exit 0
fi

reconcile_state_with_routing
current_transport="$(active_transport)"

preferred_tag='{{ (openwrt_transport_failover_candidates | first).outbound_tag | default('') }}'
preferred_healthy=false
  if candidate_healthy '{{ (openwrt_transport_failover_candidates | first).type }}' \
    "$preferred_tag" '{{ (openwrt_transport_failover_candidates | first).expected_public_ip | default('') }}' '{{ (openwrt_transport_failover_candidates | first).dataplane.independent_egress_probe | default(false) | lower }}' '{{ (openwrt_transport_failover_candidates | first).probes | default([]) | map(attribute="url") | join("|") }}' '{% for probe in (openwrt_transport_failover_candidates | first).probes | default([]) %}{{ probe.destination_ipv4 | default(['']) | first | default('') }}{% if not loop.last %}|{% endif %}{% endfor %}' '{{ (openwrt_transport_failover_candidates | first).probe_policy.required_successes | default(1) | int }}' '{{ (openwrt_transport_failover_candidates | first).probes | selectattr("expected_country", "defined") | map(attribute="expected_country") | first | default("") }}' '{{ (openwrt_transport_failover_candidates | first).endpoint.peer_public_key | default("") }}'; then
  preferred_healthy=true
fi
preferred_failures="$(state_value preferred_failures 0)"
preferred_successes="$(state_value preferred_successes 0)"

if [ "$current_transport" = "$preferred_tag" ]; then
  if [ "$preferred_healthy" = true ]; then
    write_state "$current_transport" 0 0
  else
    preferred_failures=$((preferred_failures + 1))
    write_state "$current_transport" "$preferred_failures" 0
    if [ "$preferred_failures" -lt "$dead_after_failures" ]; then
      log "preferred transport is unhealthy; waiting for ${dead_after_failures} consecutive failures (${preferred_failures}/${dead_after_failures})"
      exit 0
    fi
    log "preferred transport failure threshold reached; failover is allowed"
  fi
elif [ -n "$current_transport" ] && [ "$preferred_healthy" = true ]; then
  preferred_successes=$((preferred_successes + 1))
  write_state "$current_transport" 0 "$preferred_successes"
  if [ "$preferred_successes" -lt "$restore_after_successes" ]; then
    log "preferred transport recovered; waiting for ${restore_after_successes} consecutive successes (${preferred_successes}/${restore_after_successes})"
    exit 0
  fi
  log "preferred transport recovery threshold reached; restore is allowed"
else
  write_state "$current_transport" 0 0
fi

# Candidate selection is deliberately after the anti-flapping gates above.
# candidate_healthy may inspect a fallback, but only this block may perform
# switch_routing_outbound, and only after the required failure/recovery quorum.
selection="$(select_transport || true)"

if [ -z "$selection" ]; then
  [ "$disable_intercept_when_dead" = true ] && disable_intercept_rule
  write_state "wan_direct" 0 0
  log "no healthy transport candidate; WAN direct fallback is active"
  exit 0
fi

selected_id="${selection%%|*}"
selected_rest="${selection#*|}"
selected_type="${selected_rest%%|*}"
selected_tag="${selected_rest#*|}"

if [ "$selected_type" = xp2p_xray ]; then
  if [ "$current_transport" != "$selected_tag" ]; then
    log "transport switch requested: ${current_transport:-none} -> ${selected_tag}"
    selected_expected_ip=""
    selected_probe_urls=""
    selected_required_successes=1
{% for candidate in openwrt_transport_failover_candidates if candidate.type == 'xp2p_xray' %}
    if [ "$selected_id" = '{{ candidate.id }}' ]; then
      selected_expected_ip='{{ candidate.expected_public_ip }}'
      selected_probe_urls='{{ candidate.probes | default([]) | map(attribute="url") | join("|") }}'
      selected_probe_destinations='{% for probe in candidate.probes | default([]) %}{{ probe.destination_ipv4 | default(['']) | first | default('') }}{% if not loop.last %}|{% endif %}{% endfor %}'
      selected_required_successes={{ candidate.probe_policy.required_successes | default(1) | int }}
    fi
{% endfor %}
    switch_routing_outbound "$selected_tag" "$selected_expected_ip" "$selected_probe_urls" "$selected_probe_destinations" "$selected_required_successes" || {
      log "failed to switch managed Xray outbound to ${selected_tag}; intercept remains unchanged"
      exit 1
    }
  else
    log "transport check: ${selected_id} is healthy and remains active; no switch"
  fi
  [ "$restore_intercept_when_alive" = true ] && enable_intercept_rule
elif [ "$selected_type" = wireguard ]; then
  selected_interface="$selected_tag"
  if [ "$current_transport" != "$selected_interface" ]; then
    log "transport switch requested: ${current_transport:-none} -> ${selected_interface}"
    "$route_control_helper" set-route-interface "$selected_interface"
    write_state "$selected_interface" 0 0
    log "switched managed intercept route to WireGuard interface ${selected_interface}"
  else
    log "transport check: ${selected_id} is healthy and remains active; no switch"
  fi
  [ "$restore_intercept_when_alive" = true ] && enable_intercept_rule
else
  [ "$disable_intercept_when_dead" = true ] && disable_intercept_rule
  write_state "wan_direct" 0 0
  log "transport check: no tunnel candidate selected; WAN direct fallback remains active"
fi
